diff -ruN /mnt/data/dobby_orig/Dobby-master/include/dobby.h /mnt/data/dobby_work/Dobby-master/include/dobby.h
--- /mnt/data/dobby_orig/Dobby-master/include/dobby.h	2024-03-14 10:21:47.000000000 +0000
+++ /mnt/data/dobby_work/Dobby-master/include/dobby.h	2026-05-22 02:52:02.083663079 +0000
@@ -77,6 +77,28 @@
     } regs;
   } floating;
 } DobbyRegisterContext;
+
+#if defined(FULL_FLOATING_POINT_REGISTER_PACK)
+#define DOBBY_ARM64_FULL_FLOATING_POINT_REGISTER_PACK 1
+#else
+#define DOBBY_ARM64_FULL_FLOATING_POINT_REGISTER_PACK 0
+#endif
+
+static inline double DobbyRegisterContextGetD(const DobbyRegisterContext *ctx, int index) {
+  return (index >= 0 && index < 32) ? ctx->floating.q[index].d.d1 : 0.0;
+}
+
+static inline float DobbyRegisterContextGetS(const DobbyRegisterContext *ctx, int index) {
+  return (index >= 0 && index < 32) ? ctx->floating.q[index].f.f1 : 0.0f;
+}
+
+static inline void DobbyRegisterContextSetD(DobbyRegisterContext *ctx, int index, double value) {
+  if (index >= 0 && index < 32) ctx->floating.q[index].d.d1 = value;
+}
+
+static inline void DobbyRegisterContextSetS(DobbyRegisterContext *ctx, int index, float value) {
+  if (index >= 0 && index < 32) ctx->floating.q[index].f.f1 = value;
+}
 #elif defined(_M_IX86) || defined(__i386__)
 typedef struct _RegisterContext {
   uint32_t dummy_0;
diff -ruN /mnt/data/dobby_orig/Dobby-master/source/TrampolineBridge/ClosureTrampolineBridge/arm64/closure_bridge_arm64.asm /mnt/data/dobby_work/Dobby-master/source/TrampolineBridge/ClosureTrampolineBridge/arm64/closure_bridge_arm64.asm
--- /mnt/data/dobby_orig/Dobby-master/source/TrampolineBridge/ClosureTrampolineBridge/arm64/closure_bridge_arm64.asm	2024-03-14 10:21:47.000000000 +0000
+++ /mnt/data/dobby_work/Dobby-master/source/TrampolineBridge/ClosureTrampolineBridge/arm64/closure_bridge_arm64.asm	2026-05-22 02:52:39.024953151 +0000
@@ -10,6 +10,23 @@
 
 .globl cdecl(closure_bridge_asm)
 cdecl(closure_bridge_asm):
+#if defined(FULL_FLOATING_POINT_REGISTER_PACK)
+// alloc stack, save {q8 - q31}; required for D8-D31/S8-S31 access
+sub sp, sp, #(24 * 16)
+stp q30, q31, [sp, #(22 * 16)]
+stp q28, q29, [sp, #(20 * 16)]
+stp q26, q27, [sp, #(18 * 16)]
+stp q24, q25, [sp, #(16 * 16)]
+stp q22, q23, [sp, #(14 * 16)]
+stp q20, q21, [sp, #(12 * 16)]
+stp q18, q19, [sp, #(10 * 16)]
+stp q16, q17, [sp, #(8 * 16)]
+stp q14, q15, [sp, #(6 * 16)]
+stp q12, q13, [sp, #(4 * 16)]
+stp q10, q11, [sp, #(2 * 16)]
+stp q8, q9, [sp, #(0 * 16)]
+#endif
+
 // alloc stack, save {q0 - q7}
 sub sp, sp, #(8 * 16)
 stp q6, q7, [sp, #(6 * 16)]
@@ -42,16 +59,29 @@
 // calc original sp
 add TMP_REG_0, sp, #(2 * 8) // closure trampoline reserved
 add TMP_REG_0, TMP_REG_0, #(2 *8 + 30 * 8 + 8 * 16) // x0, x1-x30, q0-q7 reserved
+#if defined(FULL_FLOATING_POINT_REGISTER_PACK)
+add TMP_REG_0, TMP_REG_0, #(24 * 16) // q8-q31 reserved
+#endif
 
 // alloc stack, save original sp
 sub sp, sp, #(2 * 8)
 str TMP_REG_0, [sp, #(1 * 8)]
 
+// Fix ctx->lr: closure_bridge is entered via BLR, so saved x30 is the
+// bridge return address. The caller LR preserved by closure_trampoline is
+// stored at original_sp - 8. Write it into DobbyRegisterContext.lr.
+ldr x1, [TMP_REG_0, #-8]
+str x1, [sp, #(2 * 8 + 1 * 8 + 29 * 8)]
+
 // call convention: x0 = register context, x1 = interceptor entry
 mov x0, sp
+#if defined(FULL_FLOATING_POINT_REGISTER_PACK)
+ldr x1, [sp, #(2 * 8 + 2 * 8 + 30 * 8 + 8 * 16 + 24 * 16)]
+#else
 ldr x1, [sp, #(2 * 8 + 2 * 8 + 30 * 8 + 8 * 16)]
-adrp TMP_REG_0, cdecl(common_closure_bridge_handler)@PAGE
-add TMP_REG_0, TMP_REG_0, cdecl(common_closure_bridge_handler)@PAGEOFF
+#endif
+ldr TMP_REG_0, common_closure_bridge_handler_addr
+ldr TMP_REG_0, [TMP_REG_0]
 blr TMP_REG_0
 
 // restore stack, saved original sp
@@ -86,6 +116,23 @@
 ldp q6, q7, [sp, #(6 * 16)]
 add sp, sp, #(8 * 16)
 
+#if defined(FULL_FLOATING_POINT_REGISTER_PACK)
+// restore stack, saved {q8 - q31}
+ldp q8, q9, [sp, #(0 * 16)]
+ldp q10, q11, [sp, #(2 * 16)]
+ldp q12, q13, [sp, #(4 * 16)]
+ldp q14, q15, [sp, #(6 * 16)]
+ldp q16, q17, [sp, #(8 * 16)]
+ldp q18, q19, [sp, #(10 * 16)]
+ldp q20, q21, [sp, #(12 * 16)]
+ldp q22, q23, [sp, #(14 * 16)]
+ldp q24, q25, [sp, #(16 * 16)]
+ldp q26, q27, [sp, #(18 * 16)]
+ldp q28, q29, [sp, #(20 * 16)]
+ldp q30, q31, [sp, #(22 * 16)]
+add sp, sp, #(24 * 16)
+#endif
+
 ret
 
 .globl cdecl(closure_bridge_asm_end)
