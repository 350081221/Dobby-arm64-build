 } DobbyRegisterContext;
 #endif
 
+// Return the caller return address captured at the instrumented function
+// entry. This is intended for DobbyInstrument callbacks. The bridge-private
+// next-hop address is deliberately kept separate on x86/x86_64.
+static inline void *DobbyGetOriginalReturnAddress(const DobbyRegisterContext *ctx) {
+  if (!ctx)
+    return (void *)0;
+#if defined(__arm__)
+  return (void *)(uintptr_t)ctx->lr;
+#elif defined(__arm64__) || defined(__aarch64__)
+  return (void *)(uintptr_t)ctx->lr;
+#elif defined(_M_IX86) || defined(__i386__)
+  return (void *)(uintptr_t)ctx->original_ret;
+#elif defined(_M_X64) || defined(__x86_64__)
+  return (void *)(uintptr_t)ctx->original_ret;
+#else
+  return (void *)0;
+#endif
+}
