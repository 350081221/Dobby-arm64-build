diff --git a/scripts/build_android_only.sh b/scripts/build_android_only.sh
new file mode 100755
index 0000000..e8a590a
--- /dev/null
+++ b/scripts/build_android_only.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+NDK_DIR="${ANDROID_NDK_HOME:-${ANDROID_NDK_ROOT:-}}"
+OUT_DIR="${1:-${ROOT_DIR}/build-android}"
+ANDROID_API="${ANDROID_API:-21}"
+BUILD_TYPE="${BUILD_TYPE:-Release}"
+
+if [[ -z "${NDK_DIR}" || ! -f "${NDK_DIR}/build/cmake/android.toolchain.cmake" ]]; then
+  echo "Set ANDROID_NDK_HOME (or ANDROID_NDK_ROOT) to a valid Android NDK directory." >&2
+  exit 1
+fi
+
+ABIS=(armeabi-v7a arm64-v8a x86 x86_64)
+mkdir -p "${OUT_DIR}/dist"
+
+for ABI in "${ABIS[@]}"; do
+  BUILD_DIR="${OUT_DIR}/${ABI}"
+  cmake -S "${ROOT_DIR}" -B "${BUILD_DIR}" -G Ninja \
+    -DCMAKE_TOOLCHAIN_FILE="${NDK_DIR}/build/cmake/android.toolchain.cmake" \
+    -DANDROID_ABI="${ABI}" \
+    -DANDROID_PLATFORM="android-${ANDROID_API}" \
+    -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
+    -DDOBBY_ANDROID_ONLY=ON \
+    -DDOBBY_BUILD_EXAMPLE=OFF \
+    -DDOBBY_BUILD_TEST=OFF
+
+  cmake --build "${BUILD_DIR}" --target dobby dobby_static
+
+  mkdir -p "${OUT_DIR}/dist/${ABI}"
+  cp "${BUILD_DIR}/libdobby.so" "${OUT_DIR}/dist/${ABI}/"
+  cp "${BUILD_DIR}/libdobby.a" "${OUT_DIR}/dist/${ABI}/"
+done
+
+echo "Android libraries are in: ${OUT_DIR}/dist"
