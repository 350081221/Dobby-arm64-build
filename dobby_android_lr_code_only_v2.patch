diff --git a/common/os_arch_features.cc b/common/os_arch_features.cc
new file mode 100644
index 0000000..2376eb2
--- /dev/null
+++ b/common/os_arch_features.cc
@@ -0,0 +1,43 @@
+#include "common/os_arch_features.h"
+
+#include <stdint.h>
+
+#include "PlatformUnifiedInterface/platform.h"
+
+namespace features {
+namespace android {
+
+void make_memory_readable(void *address, size_t size) {
+#if defined(ANDROID) || defined(__ANDROID__)
+  if (address == nullptr || size == 0)
+    return;
+
+  const uintptr_t page_size = static_cast<uintptr_t>(OSMemory::PageSize());
+  if (page_size == 0)
+    return;
+
+  const uintptr_t begin = reinterpret_cast<uintptr_t>(address);
+  const uintptr_t end = begin + size;
+  if (end < begin)
+    return;
+
+  const uintptr_t page_begin = begin - (begin % page_size);
+  uintptr_t page_end = end;
+  const uintptr_t remainder = page_end % page_size;
+  if (remainder != 0) {
+    const uintptr_t padding = page_size - remainder;
+    if (page_end + padding < page_end)
+      return;
+    page_end += padding;
+  }
+
+  if (page_end > page_begin)
+    OSMemory::SetPermission(reinterpret_cast<void *>(page_begin), page_end - page_begin, kReadExecute);
+#else
+  (void)address;
+  (void)size;
+#endif
+}
+
+} // namespace android
+} // namespace features
